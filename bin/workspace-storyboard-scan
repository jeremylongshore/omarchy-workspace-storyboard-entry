#!/usr/bin/env bash
# Emit bounded, local Hyprland workspace state and a compact re-entry trail.
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
history_helper="$script_dir/workspace-storyboard-history"

if ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
  jq -cn '{activeId:null,workspaces:[],history:[]}'
  exit 0
fi

# Every hyprctl response is bounded in TIME and BYTES before it reaches a shell
# variable. Window titles and classes are client-influenced text, so a broken
# or malicious client could otherwise feed an unbounded or stalled stream into
# this recurring scan. Truncation at the byte ceiling can only yield invalid
# JSON, which the type checks below reject into the same safe defaults as a
# failed call — truncated data is never half-used.
hypr_max_bytes=262144
capture() { timeout 2 hyprctl -j "$1" 2>/dev/null | head -c "$hypr_max_bytes" || true; }

workspaces="$(capture workspaces)"; [[ -n "$workspaces" ]] || workspaces='[]'
active="$(capture activeworkspace)"; [[ -n "$active" ]] || active='{}'
window="$(capture activewindow)"; [[ -n "$window" ]] || window='{}'
if ! jq -e 'type == "array"' >/dev/null 2>&1 <<< "$workspaces"; then workspaces='[]'; fi
if ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "$active"; then active='{}'; fi
if ! jq -e 'type == "object"' >/dev/null 2>&1 <<< "$window"; then window='{}'; fi

id="$(jq -r '.id // empty' <<< "$active" 2>/dev/null)"
record=""
if [[ "$id" =~ ^[1-9][0-9]{0,2}$ ]]; then
  now="$(date +%s)"
  title="$(jq -r '(.title // "") | .[0:256]' <<< "$window" 2>/dev/null || printf '')"
  app="$(jq -r '(.class // "") | .[0:128]' <<< "$window" 2>/dev/null || printf '')"
  record="$(jq -cn --argjson id "$id" --arg title "$title" --arg app "$app" --argjson at "$now" '{id:$id,title:$title,app:$app,at:$at}')"
fi
history="$(printf '%s' "$record" | timeout 2 "$history_helper" 2>/dev/null || printf '[]')"
if ! jq -e 'type == "array" and length <= 40' >/dev/null 2>&1 <<< "$history"; then history='[]'; fi

# Final stdout is capped as defense in depth so the QML StdioCollector can
# never buffer unbounded output even if a bound above regresses.
out="$(jq -cn --argjson workspaces "$workspaces" --argjson active "$active" --argjson history "$history" \
  '{activeId:($active.id // null),workspaces:[$workspaces[] | {id:(.id // 0),windows:(.windows // 0),title:((.lastwindowtitle // "") | .[0:256]),app:""}],history:$history}')"
printf '%s' "${out:0:1048576}"
