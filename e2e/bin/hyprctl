#!/bin/sh
# Deterministic Hyprland contract fixture for the isolated marketplace rig.
# scripts/rig-render.sh prepends this command only inside its throwaway HOME.
set -eu

runtime="${XDG_RUNTIME_DIR:?}"
active_file="$runtime/storyboard-active-workspace"
log_file="$runtime/storyboard-hyprctl.log"

active_id() {
  if test -s "$active_file"; then
    cat "$active_file"
  else
    printf '4'
  fi
}

title_for() {
  case "$1" in
    1) printf 'Launch Plan - Q3' ;;
    2) printf 'Code Review - auth-service' ;;
    4) printf 'Deployment Runbook - Production' ;;
    7) printf 'Observability - API Latency' ;;
    *) printf 'Workspace' ;;
  esac
}

# Both dispatch forms land here. Like hyprctl, a dispatch that acted prints "ok".
switch_to() {
  case "$1" in
    1|2|4|7) ;;
    *) printf 'storyboard fixture: refused workspace %s\n' "$1" >&2; exit 2 ;;
  esac
  printf '%s\n' "$1" > "$active_file"
  printf 'dispatch:%s\n' "$1" >> "$log_file"
  printf 'ok\n'
}

case "${1:-}:${2:-}" in
  -j:workspaces)
    printf '%s\n' '[
      {"id":1,"windows":3,"lastwindowtitle":"Launch Plan - Q3"},
      {"id":2,"windows":5,"lastwindowtitle":"Code Review - auth-service"},
      {"id":4,"windows":2,"lastwindowtitle":"Deployment Runbook - Production"},
      {"id":7,"windows":4,"lastwindowtitle":"Observability - API Latency"}
    ]'
    ;;
  -j:activeworkspace)
    current="$(active_id)"
    printf '{"id":%s}\n' "$current"
    ;;
  -j:activewindow)
    current="$(active_id)"
    title="$(title_for "$current")"
    case "$current" in
      1) app='obsidian' ;;
      2) app='code' ;;
      4) app='zen-browser' ;;
      7) app='kitty' ;;
      *) app='unknown' ;;
    esac
    printf '{"title":"%s","class":"%s"}\n' "$title" "$app"
    ;;
  dispatch:workspace)
    switch_to "${3:-}"
    ;;
  dispatch:hl.dsp.focus*)
    # Hyprland 0.57's Lua dispatch, exactly as the panel sends it.
    [ "$#" -eq 2 ] || { printf 'storyboard fixture: refused Lua argv\n' >&2; exit 2; }
    target="$(printf '%s' "$2" | sed -n 's/^hl\.dsp\.focus({ workspace = "\([0-9][0-9]*\)" })$/\1/p')"
    [ -n "$target" ] || { printf 'storyboard fixture: refused Lua dispatch %s\n' "$2" >&2; exit 2; }
    switch_to "$target"
    ;;
  *)
    printf 'storyboard fixture: refused argv: %s %s %s\n' "${1:-}" "${2:-}" "${3:-}" >&2
    exit 2
    ;;
esac
